# Your Veltra API key. Get one at https://veltradata.io (the free trial works).
VELTRA_API_KEY=

# Optional: override the API base URL. Defaults to https://veltradata.io
# VELTRA_BASE_URL=https://veltradata.io

# Optional: the wallet to watch. You can also pass one as a CLI argument:
#   npm start -- <wallet-address>
# WALLET=

# Optional: chain to query (default: solana).
# CHAIN=solana

# Optional: watcher settings (defaults shown).
# POLL_INTERVAL_SECONDS=30    # how often to check for new trades
# WATCH_LIMIT=50              # how many recent trades to pull each check

# Optional: forward alerts to a Discord/Slack-compatible incoming webhook.
# ALERT_WEBHOOK_URL=
