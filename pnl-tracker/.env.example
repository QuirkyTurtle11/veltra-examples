# Your Veltra API key. Get one at https://veltrabot.com (the free trial works).
VELTRA_API_KEY=

# Optional: override the API base URL. Defaults to https://veltrabot.com
# VELTRA_BASE_URL=https://veltrabot.com

# Optional: the wallet to analyze. You can also pass one as a CLI argument:
#   npm start -- <wallet-address>
# WALLET=

# Optional: chain to query (default: solana).
# CHAIN=solana
