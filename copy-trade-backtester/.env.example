# Your Veltra API key. Get one at https://veltrabot.com (the free trial works).
VELTRA_API_KEY=

# Optional: override the API base URL. Defaults to https://veltrabot.com
# VELTRA_BASE_URL=https://veltrabot.com

# Optional: the leader wallet to copy. You can also pass one as a CLI argument:
#   npm start -- <wallet-address>
# WALLET=

# Optional: chain to query (default: solana).
# CHAIN=solana

# Optional: simulation settings (defaults shown).
# BANKROLL_SOL=100     # starting capital
# POSITION_SOL=1       # SOL committed per copied buy
# SLIPPAGE_BPS=100     # slippage per fill in basis points (100 = 1%)
